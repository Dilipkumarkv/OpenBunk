# Copy this file to .env and fill in real values. Never commit .env.
# Frontend (Vite only exposes VITE_* vars to the client — never put secrets in them)
VITE_API_URL=http://localhost:8000

# Backend (FastAPI + SQLAlchemy) — copy to backend/.env or export before running
# SQLAlchemy driver: psycopg (v3). Local dev default is SQLite (./openbunk.db)
DATABASE_URL=postgresql+psycopg://openbunk:openbunk@localhost:5432/openbunk
# CORS origins, comma-separated — must include the frontend origin you use
# (dev 5173; vite preview 4199; production domain). Production requires https origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4199,http://127.0.0.1:4199
# REQUIRED: development | test | staging | production. Production refuses SQLite,
# wildcard/plain-http CORS origins, weak database passwords and default seed PINs.
ENVIRONMENT=development
# in-memory rate limit for /api/v1/session (per client IP, per minute)
RATE_LIMIT_PER_MINUTE=20
# Demo seed PIN (6+ digits) — development/staging only. Leave empty so no demo
# employees are seeded. Never reuse the demo PIN on a real station.
OPENBUNK_SEED_PIN=

# docker-compose stack only
# PUBLIC_ORIGIN is the browser origin served by the web container (loopback bind)
PUBLIC_ORIGIN=http://localhost:8080
# Password for the bundled Postgres container. Use 12+ random characters for
# anything beyond a local dev stack; production refuses common defaults.
POSTGRES_PASSWORD=openbunk-dev-only
