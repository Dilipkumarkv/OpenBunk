# Copy this file to .env and fill in real values. Never commit .env.
# Frontend (Vite only exposes VITE_* vars to the client — never put secrets in them)
VITE_API_URL=http://localhost:8000

# Backend (FastAPI + SQLAlchemy) — copy to backend/.env or export before running
# SQLAlchemy driver: psycopg (v3). Local dev default is SQLite (./openbunk.db)
DATABASE_URL=postgresql+psycopg://openbunk:openbunk@localhost:5432/openbunk
# CORS origins, comma-separated
CORS_ORIGINS=http://localhost:5173
# production disables /api/docs and /api/openapi.json
ENVIRONMENT=development
# in-memory rate limit for /api/v1/session (per client IP, per minute)
RATE_LIMIT_PER_MINUTE=20
